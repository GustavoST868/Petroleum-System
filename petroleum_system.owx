    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#temperature</IRI>
        <Literal xml:lang="en">Temperature is a quality inhering in a material entity that represents the measure of the average kinetic energy of its constituent particles.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#temperature</IRI>
        <Literal xml:lang="pt-br">Temperature é uma qualidade, representando a medida da energia cinética média das partículas constituintes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#trap</IRI>
