    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <IRI>#trap</IRI>
        <Literal xml:lang="en">trap</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#trap</IRI>
        <Literal xml:lang="en">A Trap is a geological structure that defines a tectonic or stratigraphic geometry and is materialized in one or more rock bodies.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#trap</IRI>
        <Literal xml:lang="pt-br">Armadilha é uma estrutura geológica  que configura uma geometria tectônica ou estratigráfica, materializada em um ou mais corpos rochosos.</Literal>
    </AnnotationAssertion>
</Ontology>



