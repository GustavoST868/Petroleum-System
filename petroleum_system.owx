    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <IRI>#source</IRI>
        <Literal xml:lang="pt-br">geradoura</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <IRI>#source</IRI>
        <Literal xml:lang="en">source</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#source</IRI>
        <Literal xml:lang="pt-br">Geradora é uma disposição de uma camada de rocha que, sob condições específicas de pressão e temperatura, confere a capacidade de gerar e expelir hidrocarbonetos a partir da matéria orgânica nela contida.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#source</IRI>
        <Literal xml:lang="en">Source is a disposition inhering in a rock layer that, under specific pressure and temperature conditions, confers the capacity to generate and expel hydrocarbons from the organic matter contained within it.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#temperature</IRI>
        <Literal xml:lang="en">Reference:
L. B. Magoon, W. G. Dow, The petroleum system, in: L. B. Magoon, W. G. Dow (Eds.), The Petroleum System: From Source to Trap, volume 60 of AAPG Memoir, American Association of Petroleum Geologists, Tulsa, Oklahoma, 1994, pp. 3–24.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <IRI>#temperature</IRI>
        <Literal xml:lang="pt-br">temperatura</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <IRI>#temperature</IRI>
